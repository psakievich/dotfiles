#!/bin/sh
# Run the tools' spack with its config scopes.
#   sspack <args>             build scope (DOT_BUILD_ROOT install tree)
#   sspack --runtime <args>   runtime scope (DOT_RUNTIME_ROOT install tree)
here=$(cd -- "$(dirname -- "$0")" && pwd -P)
scope=build
if [ "${1:-}" = --runtime ]; then scope=runtime; shift; fi
: "${DOT_BUILD_ROOT:=$here/.build}"
: "${DOT_RUNTIME_ROOT:=$HOME/.local/opt/dotfiles}"
export DOT_BUILD_ROOT DOT_RUNTIME_ROOT
export SPACK_DISABLE_LOCAL_CONFIG=1 SPACK_USER_CACHE_PATH="$DOT_BUILD_ROOT/user-cache"
exec "$DOT_BUILD_ROOT/spack/bin/spack" -C "$here/configs/common" -C "$here/configs/$scope" "$@"
